{
  "name": "pico-creator",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "exports": {
    "./editor": {
      "types": "./types/editor.d.ts",
      "import": "./lib/editor.js"
    },
    "./exports": {
      "types": "./types/exports.d.ts",
      "import": "./lib/exports.js"
    },
    "./editor.css": "./lib/pico-editor.css",
    "./schema": "./pico-document.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "types",
    "pico-document.schema.json"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "ajv": "^8.17.1",
    "docx": "^9.5.0",
    "lucide-react": "^0.468.0",
    "pdfmake": "0.2.20"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
