    "pregunta_clinica": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "En pacientes con dermatomiositis, ¿cuál es el efecto (eficacia y seguridad) de los inmunosupresores sintéticos convencionales, sintéticos dirigidos y biológicos?"
            }
          ]
        }
      ]
    },
    "tipo_pregunta": {
      "codigo": "INTERVENCION",
      "plantilla": "intervencion",
      "plantilla_version": "1.0"
    },
