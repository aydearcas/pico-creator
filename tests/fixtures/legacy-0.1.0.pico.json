    "poblacion": {
      "texto": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Pacientes adultos (≥ 18 años) diagnosticados de dermatomiositis (clásica, amiopática e hipomiopática)."
              }
            ]
          }
        ]
      },
      "subpoblaciones": []
    },
    "intervenciones": [
