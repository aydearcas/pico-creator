      "text": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Pacientes adultos (≥ 18 años) diagnosticados de dermatomiositis (clásica, amiopática e hipomiopática)."
              }
            ]
          }
        ]
      },
      "subpopulations": []
    },
    "interventions": [
      {
        "id": "9c8bc7df-f5e0-4d6c-9480-cfebf79fba3a",
