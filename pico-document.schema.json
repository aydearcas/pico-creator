{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pico-creator.local/schemas/pico-document-1.0.0.json",
  "title": "PICO document 1.0.0",
  "description": "Portable, rich clinical question. UTF-8; one question per file.",
  "type": "object",
  "properties": {
    "format": {
      "const": "pico-document"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "text_format": {
      "const": "richtext-v1"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "document_revision": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "review_link": {
      "type": [
        "object",
        "null"
      ]
    },
    "pico": {
      "type": "object",
      "properties": {
        "number": {
          "type": "string"
        },
        "section": {
          "$ref": "#/$defs/rich"
        },
        "clinical_question": {
          "$ref": "#/$defs/rich"
        },
        "question_type": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "INTERVENTION",
                "SAFETY",
                "DIAGNOSTIC",
                "PROGNOSIS",
                "PREDICTION",
                "ETIOLOGY",
                "EXPOSURE",
                "PREVALENCE",
                "QUALITATIVE",
                "OTHER"
              ]
            },
            "template": {
              "enum": [
                "intervention",
                "diagnostic",
                "prognosis",
                "other"
              ]
            },
            "template_version": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "template",
            "template_version"
          ]
        },
        "criteria_version": {
          "type": "string"
        },
        "population": {
          "type": "object",
          "properties": {
            "text": {
              "$ref": "#/$defs/rich"
            },
            "subpopulations": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "$ref": "#/$defs/rich"
                  }
                },
                "required": [
                  "id",
                  "text"
                ]
              }
            }
          },
          "required": [
            "text",
            "subpopulations"
          ]
        },
        "interventions": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/free"
          }
        },
        "comparators": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/comparator"
          }
        },
        "outcomes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "study_designs": {
          "type": "object",
          "properties": {
            "catalog_version": {
              "type": "string"
            },
            "included": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/design"
              }
            },
            "excluded": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/design"
              }
            },
            "remainder_excluded": {
              "type": "boolean"
            }
          },
          "required": [
            "catalog_version",
            "included",
            "excluded",
            "remainder_excluded"
          ]
        },
        "publication_types": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                null,
                "FULL_REPORTS_ONLY",
                "FULL_REPORTS_AND_OTHERS"
              ]
            },
            "additional": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/publication"
              }
            },
            "conditions": {
              "$ref": "#/$defs/rich"
            }
          },
          "required": [
            "mode",
            "additional",
            "conditions"
          ]
        },
        "reviewer_notes": {
          "$ref": "#/$defs/rich"
        },
        "variable_catalogs": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "catalogs",
                "active_id",
                "visible"
              ],
              "properties": {
                "catalogs": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "$ref": "#/$defs/variableCatalog"
                  }
                },
                "active_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "visible": {
                  "type": "boolean"
                }
              }
            }
          ]
        }
      },
      "required": [
        "number",
        "section",
        "clinical_question",
        "question_type",
        "criteria_version",
        "population",
        "interventions",
        "comparators",
        "outcomes",
        "study_designs",
        "publication_types",
        "reviewer_notes"
      ]
    }
  },
  "required": [
    "format",
    "schema_version",
    "text_format",
    "document_id",
    "document_revision",
    "created_at",
    "updated_at",
    "review_link",
    "pico"
  ],
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "doc",
            "paragraph",
            "text",
            "hardBreak",
            "bulletList",
            "listItem"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/mark"
          }
        }
      },
      "required": [
        "type"
      ]
    },
    "mark": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "bold",
            "italic",
            "strike",
            "highlight",
            "textStyle"
          ]
        },
        "attrs": {
          "type": "object",
          "properties": {
            "color": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": []
        }
      },
      "required": [
        "type"
      ]
    },
    "rich": {
      "allOf": [
        {
          "$ref": "#/$defs/node"
        },
        {
          "properties": {
            "type": {
              "const": "doc"
            }
          },
          "required": [
            "type",
            "content"
          ]
        }
      ]
    },
    "child": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "$ref": "#/$defs/rich"
        },
        "children": {
          "type": "array",
          "maxItems": 0
        },
        "catalog_origin": {
          "$ref": "#/$defs/catalogProvenance"
        }
      },
      "required": [
        "id",
        "text",
        "children"
      ]
    },
    "free": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "$ref": "#/$defs/rich"
        },
        "children": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/child"
          }
        },
        "catalog_origin": {
          "$ref": "#/$defs/catalogProvenance"
        }
      },
      "required": [
        "id",
        "text",
        "children"
      ]
    },
    "design": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "enum": [
            "ANY_DESIGN",
            "SYSTEMATIC_REVIEW",
            "META_ANALYSIS",
            "RCT",
            "NON_RANDOMIZED_TRIAL",
            "OBSERVATIONAL_ANY",
            "OBSERVATIONAL_COMPARATIVE",
            "OBSERVATIONAL_NON_COMPARATIVE",
            "CASE_SERIES",
            "CASE_REPORT",
            "DIAGNOSTIC_ACCURACY",
            "PREDICTION_MODEL",
            "QUALITATIVE_STUDY",
            "OTHER",
            ""
          ]
        },
        "min_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "conditions": {
          "$ref": "#/$defs/rich"
        }
      },
      "required": [
        "id",
        "code",
        "min_n",
        "conditions"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "SYSTEMATIC_REVIEW",
                  "META_ANALYSIS"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "min_n": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "comparator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "const": "FREE"
            },
            "role": {
              "enum": [
                "COMPARATOR",
                "REFERENCE_STANDARD",
                "OTHER"
              ]
            },
            "text": {
              "$ref": "#/$defs/rich"
            },
            "children": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/child"
              }
            },
            "catalog_origin": {
              "$ref": "#/$defs/catalogProvenance"
            }
          },
          "required": [
            "id",
            "mode",
            "role",
            "text",
            "children"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "const": "CONTROLLED"
            },
            "role": {
              "enum": [
                "COMPARATOR",
                "REFERENCE_STANDARD",
                "OTHER"
              ]
            },
            "code": {
              "enum": [
                "PLACEBO",
                "USUAL_CARE",
                "ANY_COMPARATOR",
                "OTHER_PHARMACOLOGICAL",
                "SHAM",
                "NO_COMPARISON",
                "REFERENCE_STANDARD",
                "CLINICAL_DIAGNOSIS",
                "OTHER_TEST",
                "USUAL_TEST",
                "NO_TEST_COMPARISON",
                "FACTOR_ABSENT",
                "REFERENCE_LEVEL",
                "OTHER_FACTOR_OR_MODEL",
                "USUAL_FOLLOW_UP",
                ""
              ]
            },
            "specification": {
              "$ref": "#/$defs/rich"
            },
            "children": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/child"
              }
            },
            "catalog_origin": {
              "$ref": "#/$defs/catalogProvenance"
            }
          },
          "required": [
            "id",
            "mode",
            "role",
            "code",
            "specification",
            "children"
          ]
        }
      ]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/$defs/rich"
        },
        "description": {
          "$ref": "#/$defs/rich"
        },
        "details": {
          "type": "object",
          "properties": {
            "importance": {
              "enum": [
                null,
                "CRITICAL",
                "IMPORTANT",
                "NOT_IMPORTANT"
              ]
            },
            "score": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9
            },
            "timepoints": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "string"
              }
            },
            "instruments": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "string"
              }
            },
            "thresholds": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "string"
              }
            },
            "minimal_important_difference": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "importance",
            "score",
            "timepoints",
            "instruments",
            "thresholds",
            "minimal_important_difference"
          ]
        },
        "catalog_origin": {
          "$ref": "#/$defs/catalogProvenance"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "details"
      ]
    },
    "publication": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "enum": [
            "",
            "ABSTRACT",
            "LETTER",
            "THESIS",
            "REPORT",
            "PREPRINT",
            "OTHER",
            "ANY"
          ]
        },
        "clarification": {
          "$ref": "#/$defs/rich"
        }
      },
      "required": [
        "id",
        "code",
        "clarification"
      ]
    },
    "variableCatalog": {
      "title": "PICO Creator candidate variable catalogue 0.2.0",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schema_version",
        "catalog_id",
        "title",
        "question_type",
        "clinical_question",
        "population_notes",
        "verification",
        "sources",
        "interventions",
        "comparators",
        "outcomes"
      ],
      "properties": {
        "format": {
          "const": "pico-variable-catalog"
        },
        "schema_version": {
          "const": "0.2.0"
        },
        "catalog_id": {
          "$ref": "#/$defs/variableCatalog/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/variableCatalog/$defs/bilingual"
        },
        "question_type": {
          "enum": [
            "intervention",
            "diagnostic",
            "prognosis",
            "other"
          ]
        },
        "clinical_question": {
          "$ref": "#/$defs/variableCatalog/$defs/bilingual"
        },
        "population_notes": {
          "$ref": "#/$defs/variableCatalog/$defs/note"
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checked_on",
            "limitations"
          ],
          "properties": {
            "status": {
              "enum": [
                "source_reviewed",
                "partially_reviewed",
                "unverified"
              ]
            },
            "checked_on": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "limitations": {
              "$ref": "#/$defs/variableCatalog/$defs/note"
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/variableCatalog/$defs/source"
          }
        },
        "interventions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/variableCatalog/$defs/intervention"
          }
        },
        "comparators": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/variableCatalog/$defs/comparator"
          }
        },
        "outcomes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/variableCatalog/$defs/outcome"
          }
        }
      },
      "$defs": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "bilingual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "es",
            "en"
          ],
          "properties": {
            "es": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            }
          }
        },
        "note": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "es",
            "en"
          ],
          "properties": {
            "es": {
              "type": "string",
              "minLength": 0,
              "maxLength": 6000
            },
            "en": {
              "type": "string",
              "minLength": 0,
              "maxLength": 6000
            }
          }
        },
        "leaf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "description",
            "source_ids"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/variableCatalog/$defs/id"
            },
            "label": {
              "$ref": "#/$defs/variableCatalog/$defs/bilingual"
            },
            "description": {
              "$ref": "#/$defs/variableCatalog/$defs/note"
            },
            "source_ids": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/variableCatalog/$defs/id"
              }
            }
          }
        },
        "intervention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "description",
            "source_ids",
            "children"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/variableCatalog/$defs/id"
            },
            "label": {
              "$ref": "#/$defs/variableCatalog/$defs/bilingual"
            },
            "description": {
              "$ref": "#/$defs/variableCatalog/$defs/note"
            },
            "source_ids": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/variableCatalog/$defs/id"
              }
            },
            "children": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/variableCatalog/$defs/leaf"
              }
            }
          }
        },
        "comparator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "description",
            "source_ids",
            "controlled_code",
            "children"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/variableCatalog/$defs/id"
            },
            "label": {
              "$ref": "#/$defs/variableCatalog/$defs/bilingual"
            },
            "description": {
              "$ref": "#/$defs/variableCatalog/$defs/note"
            },
            "source_ids": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/variableCatalog/$defs/id"
              }
            },
            "controlled_code": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "PLACEBO",
                "USUAL_CARE",
                "ANY_COMPARATOR",
                "OTHER_PHARMACOLOGICAL",
                "SHAM",
                "NO_COMPARISON",
                "REFERENCE_STANDARD",
                "CLINICAL_DIAGNOSIS",
                "OTHER_TEST",
                "USUAL_TEST",
                "NO_TEST_COMPARISON",
                "FACTOR_ABSENT",
                "REFERENCE_LEVEL",
                "OTHER_FACTOR_OR_MODEL",
                "USUAL_FOLLOW_UP"
              ]
            },
            "children": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/variableCatalog/$defs/leaf"
              }
            }
          }
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "description",
            "source_ids"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/variableCatalog/$defs/id"
            },
            "label": {
              "$ref": "#/$defs/variableCatalog/$defs/bilingual"
            },
            "description": {
              "$ref": "#/$defs/variableCatalog/$defs/note"
            },
            "source_ids": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/variableCatalog/$defs/id"
              }
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "source_type",
            "title",
            "url",
            "locator",
            "accessed_on"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/variableCatalog/$defs/id"
            },
            "source_type": {
              "enum": [
                "public_source",
                "provided_document"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "url": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^https?://"
            },
            "locator": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1500
            },
            "accessed_on": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "source_type": {
                    "const": "public_source"
                  }
                }
              },
              "then": {
                "properties": {
                  "url": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "properties": {
                  "status": {
                    "const": "source_reviewed"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "sources": {
                "minItems": 1
              },
              "verification": {
                "properties": {
                  "checked_on": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "catalogProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "variable_id"
      ],
      "properties": {
        "catalog_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "variable_id": {
          "type": "string",
          "minLength": 1,
